MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/digimart
JWT_SECRET=replace-with-a-long-random-string
PAYPAL_CLIENT_ID=
PAGINATION_LIMIT=8

# Optional locally. Vercel injects this through the forecasting service binding.
FORECAST_API_URL=
FORECAST_TIMEOUT_MS=120000

# Required on Vercel for the protected on-demand recalculation endpoint.
# Use the same long random value for the backend and forecasting services.
FORECAST_RECALC_SECRET=replace-with-another-long-random-string
FORECAST_RECALC_TIMEOUT_MS=280000
