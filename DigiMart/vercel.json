{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "create-react-app",
      "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
    },
    "backend": {
      "root": "backend",
      "framework": "express",
      "entrypoint": "app.js",
      "bindings": [
        {
          "type": "service",
          "service": "forecasting",
          "format": "url",
          "env": "FORECAST_API_URL"
        }
      ]
    },
    "forecasting": {
      "root": "backend/forcasting",
      "framework": "flask",
      "entrypoint": "forcastingengine:app",
      "functions": {
        "**/*.py": {
          "maxDuration": 300,
          "includeFiles": "cleaned_customer_data.csv"
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "backend" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "frontend" }
    }
  ]
}
